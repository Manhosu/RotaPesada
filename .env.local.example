# Rota Pesada — variáveis de ambiente (copie para .env.local)
# Encontre estes valores em: Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Mapbox — APENAS mapa (tiles) + geocoding (busca). Não faz roteamento de caminhão.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.sua-chave-mapbox

# OpenRouteService — roteamento de CAMINHÃO (driving-hgv). Chave grátis em
# https://openrouteservice.org/dev/#/signup . Sem ela, o app cai no fallback
# (rota de carro do Mapbox + desvio só da nossa camada).
NEXT_PUBLIC_ORS_API_KEY=sua-chave-openrouteservice
